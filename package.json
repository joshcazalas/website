{
  "name": "joshcazalas-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:fetch": "python3 scripts/assets.py fetch",
    "assets:verify": "python3 scripts/assets.py verify",
    "check": "tsc --noEmit",
    "build": "npm run check && python3 scripts/prepare-public.py && vite build",
    "test:unit": "npm run test:geometry && npm run test:deployment && npm run test:playback && npm run test:release",
    "test:packaging": "python3 -m unittest discover -s scripts -p '*_test.py' -v",
    "test:production": "node scripts/production-check.mjs",
    "release:package": "python3 scripts/package-release.py",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.mjs",
    "test:outpost": "node scripts/outpost-check.mjs",
    "test:deployment": "node --experimental-strip-types scripts/foundation-deployment.test.mjs",
    "test:playback": "node --experimental-strip-types scripts/auxide-playback.test.mjs",
    "test:auxide": "node scripts/auxide-check.mjs",
    "test:geometry": "node --experimental-strip-types scripts/paths.test.mjs",
    "test:release": "node --experimental-strip-types scripts/caz-release.test.mjs",
    "test:caz": "node scripts/caz-check.mjs",
    "test:menu": "node scripts/menu-check.mjs"
  },
  "dependencies": {
    "pixi.js": "^8.13.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
