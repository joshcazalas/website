{
  "name": "joshcazalas-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.9.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "assets:import": "node scripts/import-assets.ts",
    "assets:fetch": "node scripts/assets.ts fetch",
    "assets:verify": "node scripts/assets.ts verify",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json",
    "build": "npm run check && node scripts/prepare-public.ts && vite build",
    "test:unit": "npm run test:geometry && npm run test:deployment && npm run test:playback && npm run test:release",
    "test:packaging": "node --test scripts/assets.test.ts scripts/build-artifact.test.ts",
    "test:production": "node scripts/production-check.ts",
    "release:package": "node scripts/package-release.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node scripts/browser-check.ts",
    "test:outpost": "node scripts/outpost-check.ts",
    "test:deployment": "node scripts/foundation-deployment.test.ts",
    "test:playback": "node scripts/auxide-playback.test.ts",
    "test:auxide": "node scripts/auxide-check.ts",
    "test:geometry": "node scripts/paths.test.ts && node scripts/belt-network.test.ts",
    "test:release": "node scripts/caz-release.test.ts",
    "test:caz": "node scripts/caz-check.ts",
    "test:menu": "node scripts/menu-check.ts"
  },
  "dependencies": {
    "pixi.js": "^8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.2",
    "sharp": "^0.35.4",
    "tar": "7.5.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
