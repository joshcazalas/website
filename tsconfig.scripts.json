{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "target": "ES2024",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/**/*.ts",
    "vite.config.ts"
  ]
}
